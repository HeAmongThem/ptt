# Intégration SharePoint (dépôt des fichiers d'import d'indicateurs)
SHAREPOINT_URL=https://okmitconsulting.sharepoint.com/sites/Rgulation/Shared%20Documents/Forms/AllItems.aspx
SHAREPOINT_USE=true
# Sous-dossier de la bibliothèque où déposer les fichiers (créé s'il n'existe pas)
SHAREPOINT_FOLDER=Régulation
# Délai maximal (secondes) laissé à l'utilisateur pour s'authentifier
SHAREPOINT_LOGIN_TIMEOUT=180
DEMO=false
TRUST_TOWER_API=http://127.0.0.1:8778/api/run
# Authentification API (optionnelle) : POST {"secret": CLIENT_SECRET} sur URL_TOKEN au démarrage,
# le jeton reçu (access_token) est envoyé en Authorization: Bearer à TRUST_TOWER_API.
URL_TOKEN=http://localhost:8778/api/get_token
CLIENT_SECRET="un_client_secret"
